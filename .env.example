# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env
#
# A senha do SQL Server precisa satisfazer a política de complexidade do produto:
# ao menos 8 caracteres, com maiúscula, minúscula, dígito e símbolo. Se não
# satisfizer, o container sobe e encerra em seguida.
MSSQL_SA_PASSWORD=Desenvolvimento@2026
MSSQL_PORTA=1433
# Porta do navegador quando a aplicação completa sobe pelo compose.
FRONTEND_PORTA=8080
